{
  "name": "ericmilan-website",
  "version": "2.0.0",
  "private": true,
  "description": "Eric Milan's portfolio on Cloudflare Workers with private Web Analytics",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:worker && npm run check:html",
    "test:worker": "vitest run",
    "cypress:run": "cypress run --config-file test/cypress.config.js",
    "test:e2e": "start-server-and-test dev http://localhost:8790 cypress:run",
    "check:html": "html-validate 'frontend/**/*.html' && linkinator frontend --recurse --skip '^(mailto:|https://(ericmilan\\.dev|www\\.inovalon\\.com|www\\.wjhsd\\.net|www\\.frazierschooldistrict\\.org|github\\.com|www\\.linkedin\\.com))'",
    "check:lighthouse": "start-server-and-test dev http://localhost:8790 lighthouse:run",
    "lighthouse:run": "node scripts/lighthouse.mjs",
    "types": "wrangler types",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "chrome-launcher": "1.2.1",
    "cypress": "15.21.1",
    "cypress-axe": "1.7.0",
    "html-validate": "11.15.0",
    "lighthouse": "13.4.1",
    "linkinator": "8.1.0",
    "start-server-and-test": "3.0.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "sharp": "0.35.4",
    "workerd": "1.20260910.1"
  },
  "keywords": ["portfolio", "cloudflare-workers", "static-assets", "web-analytics"],
  "author": "Eric Milan",
  "license": "MIT"
}
